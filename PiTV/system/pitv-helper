#!/usr/bin/env python3
import json, os, shutil, subprocess, sys, tempfile, urllib.request

ALLOWED_STORE_APT = {"kodi", "vlc"}

def out(msg, code=0):
    print(msg)
    raise SystemExit(code)

def run(args, timeout=600, stdin=None, env=None):
    p = subprocess.run(args, input=stdin, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                       text=True, timeout=timeout, check=False, env=env)
    text = (p.stdout or "").strip()
    if p.returncode != 0:
        out(text or f"Chyba ({p.returncode})", p.returncode)
    return text

if os.geteuid() != 0:
    out("PiTV helper musí běžet jako root", 1)

action = sys.argv[1] if len(sys.argv) > 1 else ""
try:
    payload = json.loads(sys.stdin.read() or "{}")
except Exception:
    payload = {}

if action == "wifi-radio":
    enabled = bool(payload.get("enabled"))
    run(["nmcli", "radio", "wifi", "on" if enabled else "off"], timeout=20)
    out("Wi‑Fi zapnuto" if enabled else "Wi‑Fi vypnuto")

elif action == "wifi-connect":
    ssid = str(payload.get("ssid",""))[:128]
    password = str(payload.get("password",""))[:256]
    if not ssid:
        out("Chybí SSID", 2)
    args = ["nmcli", "device", "wifi", "connect", ssid]
    if password:
        args += ["password", password]
    text = run(args, timeout=45)
    out(text or f"Připojeno k {ssid}")

elif action == "wifi-disconnect":
    dev = str(payload.get("device",""))[:64]
    if not dev or not dev.replace("-","").replace("_","").isalnum():
        out("Neplatné Wi‑Fi zařízení", 2)
    run(["nmcli", "device", "disconnect", dev], timeout=20)
    out(f"{dev} odpojeno")

elif action == "waydroid-container-start":
    if shutil.which("waydroid") is None:
        out("Waydroid není nainstalovaný", 2)
    run(["waydroid", "container", "start"], timeout=60)
    out("Waydroid container spuštěn")

elif action == "waydroid-container-stop":
    if shutil.which("waydroid") is None:
        out("Waydroid není nainstalovaný", 2)
    run(["waydroid", "container", "stop"], timeout=60)
    out("Waydroid container zastaven")

elif action == "apt-install":
    package = str(payload.get("package", "")).strip()
    if package not in ALLOWED_STORE_APT:
        out("Balíček není povolený v PiTV Store", 2)
    env = os.environ.copy()
    env["DEBIAN_FRONTEND"] = "noninteractive"
    run(["apt-get", "update"], timeout=300, env=env)
    run(["apt-get", "-y", "install", package], timeout=1200, env=env)
    out(f"{package} nainstalováno")

elif action == "pitv-self-update":
    updater = "/usr/local/libexec/pitv-self-update"
    if not os.path.isfile(updater):
        out("PiTV updater není nainstalovaný", 2)
    text = run([updater], timeout=1800)
    out(text or "PiTV aktualizováno")

elif action == "store-catalog-update":
    url = "https://raw.githubusercontent.com/CaseyCZ/CaseyCZ/pitv-v1/PiTV/store/catalog.json"
    target_dir = "/etc/pitv/store"
    target = os.path.join(target_dir, "catalog.json")
    os.makedirs(target_dir, exist_ok=True)
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "PiTV-Updater/1.1"})
        with urllib.request.urlopen(req, timeout=30) as r:
            data = r.read()
        parsed = json.loads(data.decode("utf-8"))
        if not isinstance(parsed, dict) or not isinstance(parsed.get("apps"), list):
            out("Stažený Store katalog není platný", 2)
        fd, tmp = tempfile.mkstemp(prefix="catalog-", suffix=".json", dir=target_dir)
        try:
            with os.fdopen(fd, "wb") as h:
                h.write(data)
            os.chmod(tmp, 0o644)
            os.replace(tmp, target)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
        out("PiTV Store katalog aktualizován")
    except Exception as e:
        out(f"Aktualizace Store katalogu selhala: {e}", 2)

elif action == "apt-store-upgrade":
    packages = payload.get("packages", [])
    if not isinstance(packages, list):
        out("Neplatný seznam balíčků", 2)
    packages = [str(x).strip() for x in packages if str(x).strip()]
    if any(p not in ALLOWED_STORE_APT for p in packages):
        out("Seznam obsahuje nepovolený Store balíček", 2)
    if not packages:
        out("Žádné Linux Store aplikace k aktualizaci")
    env = os.environ.copy()
    env["DEBIAN_FRONTEND"] = "noninteractive"
    run(["apt-get", "update"], timeout=300, env=env)
    run(["apt-get", "-y", "install", "--only-upgrade"] + packages, timeout=1200, env=env)
    out("Linux Store aplikace aktualizovány")

elif action == "apt-update":
    env = os.environ.copy()
    env["DEBIAN_FRONTEND"] = "noninteractive"
    run(["apt-get", "update"], timeout=300, env=env)
    out("Seznam aktualizací obnoven")

elif action == "apt-upgrade":
    env = os.environ.copy()
    env["DEBIAN_FRONTEND"] = "noninteractive"
    run(["apt-get", "-y", "upgrade"], timeout=1200, env=env)
    out("Aktualizace nainstalovány")

else:
    out("Nepovolená akce", 2)
